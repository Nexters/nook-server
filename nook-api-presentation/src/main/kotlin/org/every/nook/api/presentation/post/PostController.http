### 카카오 로그인
POST {{baseUrl}}/api/v1/auth/social
Content-Type: application/json

{
  "provider": "KAKAO",
  "accessToken": "replace-with-kakao-access-token"
}

@postId = 1
@placeId = 1

### URL로 게시물 생성
POST {{baseUrl}}/api/v1/posts
Content-Type: application/json

{
  "url": "https://www.instagram.com/p/ABC123/",
  "memo": "주말에 방문"
}

### 게시물 연관 장소 북마크 변경
PATCH {{baseUrl}}/api/v1/posts/{{postId}}/places/{{placeId}}/bookmark
Content-Type: application/json

{
  "bookmarked": true
}

### 게시물 장소 파싱 결과 조회
GET {{baseUrl}}/api/v1/posts/{{postId}}/place-parsing
