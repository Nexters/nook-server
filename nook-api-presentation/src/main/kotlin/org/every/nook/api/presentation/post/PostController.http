### 카카오 로그인
POST {{baseUrl}}/api/v1/auth/social
Content-Type: application/json

{
  "provider": "KAKAO",
  "accessToken": "replace-with-kakao-access-token"
}

@postId = 1
@placeId = 1
@selectionToken = replace-with-place-selection-token

### 저장 게시물 목록 조회
# 응답에 processingStatus, processingStage, processingPercent가 포함됩니다.
GET {{baseUrl}}/api/v1/posts?page=0&size=20

### 저장 게시물 상세 조회
# 장소 응답에 tags(최대 4개)가 포함되고, 응답에 processingPercent가 포함됩니다.
GET {{baseUrl}}/api/v1/posts/{{postId}}

### 내 저장 게시물 삭제
DELETE {{baseUrl}}/api/v1/posts/{{postId}}

### URL로 게시물 저장 시작 - 콘텐츠와 장소는 백그라운드 처리
# 응답에 processingStatus, processingStage, processingPercent가 포함됩니다.
POST {{baseUrl}}/api/v1/posts
Content-Type: application/json

{
  "url": "https://www.instagram.com/p/ABC123/",
  "memo": "주말에 방문",
  "groupIds": [1, 2]
}

### URL로 게시물 생성 실패 - 그룹 누락
POST {{baseUrl}}/api/v1/posts
Content-Type: application/json

{
  "url": "https://www.instagram.com/p/ABC123/"
}

### URL로 게시물 생성 실패 - 비공개 게시물
POST {{baseUrl}}/api/v1/posts
Content-Type: application/json

{
  "url": "https://www.instagram.com/p/Dbw1jDTBv7du60ZhDSqNH9kSJCYlKc6TzHaACA0/",
  "groupIds": [1]
}

### 내 저장 게시물 메모 변경
PATCH {{baseUrl}}/api/v1/posts/{{postId}}/memo
Content-Type: application/json

{
  "memo": "다음 주 평일에 방문"
}

### 내 저장 게시물 메모 삭제
PATCH {{baseUrl}}/api/v1/posts/{{postId}}/memo
Content-Type: application/json

{
  "memo": null
}

### 내 저장 게시물 장소 메모 변경
PATCH {{baseUrl}}/api/v1/posts/{{postId}}/places/{{placeId}}/memo
Content-Type: application/json

{
  "memo": "대표 메뉴는 라자냐"
}

### 내 저장 게시물 장소 메모 삭제
PATCH {{baseUrl}}/api/v1/posts/{{postId}}/places/{{placeId}}/memo
Content-Type: application/json

{
  "memo": null
}

### 내 저장 게시물 그룹 전체 재지정
PUT {{baseUrl}}/api/v1/posts/{{postId}}/groups
Content-Type: application/json

{
  "groupIds": [1, 2]
}

### 게시물 연관 장소 북마크 변경
PATCH {{baseUrl}}/api/v1/posts/{{postId}}/places/{{placeId}}/bookmark
Content-Type: application/json

{
  "bookmarked": true
}

### 게시물 장소 파싱 결과 조회
GET {{baseUrl}}/api/v1/posts/{{postId}}/place-parsing

### 저장 게시물에 장소 직접 연결
POST {{baseUrl}}/api/v1/posts/{{postId}}/places
Content-Type: application/json

{
  "selectionToken": "{{selectionToken}}"
}
